ext","text":" object after the middleware (i.e. "},{"type":"text","marks":[{"type":"code","attrs":{"class":"inline-code"}}],"text":"req.body"},{"type":"text","text":"), or an empty object ("},{"type":"text","marks":[{"type":"code","attrs":{"class":"inline-code"}}],"text":"{}"},{"type":"text","text":") if there was no body to parse, the "},{"type":"text","marks":[{"type":"code","attrs":{"class":"inline-code"}}],"text":"Content-Type"},{"type":"text","text":" was not matched, or an error occurred."}]},{"type":"blockquote","content":[{"type":"paragraph","attrs":{"id":"sdsF2cjWB9IJWHFWxQ_c5"},"content":[{"type":"text","text":"As "},{"type":"text","marks":[{"type":"code","attrs":{"class":"inline-code"}}],"text":"req.body"},{"type":"text","text":"’s shape is based on user-controlled input, all properties and values in this object are untrusted and should be validated before trusting. For example, "},{"type":"text","marks":[{"type":"code","attrs":{"class":"inline-code"}}],"text":"req.body.foo.toString()"},{"type":"text","text":" may fail in multiple ways, for example "},{"type":"text","marks":[{"type":"code","attrs":{"class":"inline-code"}}],"text":"foo"},{"type":"text","text":" may not be there or may not be a string, and "},{"type":"text","marks":[{"type":"code","attrs":{"class":"inline-code"}}],"text":"toString"},{"type":"text","text":" may not be a function and instead a string or other user-input."}]}]},{"type":"paragraph","attrs":{"id":"MUSuWqAiSO_Z5az2pPN1W"},"content":[{"type":"text","text":"The following table describes the properties of the optional "},{"type":"text","marks":[{"type":"code","attrs":{"class":"inline-code"}}],"text":"options"},{"type":"text","text":" object."}]},{"type":"paragraph","attrs":{"id":"Qaw0oef5nIl23q7LINIx4"},"content":[{"type":"text","text":"..."}]},{"type":"heading","attrs":{"id":"9d9d8f04-1ee5-41a9-af9b-9113e0030970","data-toc-id":"9d9d8f04-1ee5-41a9-af9b-9113e0030970","level":1},"content":[{"type":"text","text":"Events"}]},{"type":"pa